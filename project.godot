; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenSurvivors"
run/main_scene="uid://bcolnekflouth"
config/features=PackedStringArray("4.6")

[autoload]

SaveManager="*res://scripts/services/save_manager.gd"
AudioManager="*res://scripts/services/audio_manager.gd"
PowerUpManager="*res://scripts/services/powerup_manager.gd"
I18N="*res://scripts/services/i18n.gd"
RelicManager="*res://scripts/services/relic_manager.gd"
ArcanaManager="*res://scripts/services/arcana_manager.gd"
SceneManager="*res://scripts/services/scene_manager.gd"
EnemyRegistry="*res://scripts/services/enemy_registry.gd"
ObjectPoolManager="*res://scripts/services/object_pool_manager.gd"
DataRegistry="*res://scripts/services/data_registry.gd"
EventBus="*res://scripts/services/event_bus.gd"
UnlockManager="*res://scripts/services/unlock_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-6.ttf"

